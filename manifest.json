{
  "manifest_version": 3,
  "name": "Caelestia-DNT",
  "version": "1.4.0",
  "description": "Dynamic Material You new tab synchronized with Noctalia (Niri) and Caelestia (Hyprland) on Linux",
  "permissions": [
    "windows",
    "tabs",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "host_permissions": [
    "http://127.0.0.1:39123/*",
    "*://*.youtube.com/*",
    "*://*.github.com/*",
    "*://*.reddit.com/*",
    "*://*.wikipedia.org/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.github.com/*",
        "*://*.reddit.com/*",
        "*://*.wikipedia.org/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}