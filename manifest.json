{
  "manifest_version": 3,
  "name": "Caelestia Dynamic New Tab",
  "version": "1.3.0",
  "description": "Minimalist keyboard-first new tab with dynamic Material You colors, Zen mode, and Caelestia theming on YouTube, GitHub, Reddit & Wikipedia",
  "permissions": [
    "windows",
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.github.com/*",
    "*://*.reddit.com/*",
    "*://*.wikipedia.org/*"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.github.com/*",
        "*://*.reddit.com/*",
        "*://*.wikipedia.org/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
